# Token permanente (usuario del sistema en Meta Business)
WHATSAPP_TOKEN=EAAG...
# ID del número (WhatsApp > Configuración de la API)
PHONE_NUMBER_ID=123456789012345
# Texto que vos inventás; el mismo se pone en Meta al configurar el webhook
VERIFY_TOKEN=una-clave-secreta-cualquiera
# Opcional pero recomendado: "Clave secreta de la app" (Configuración > Básica)
APP_SECRET=
GRAPH_VERSION=v23.0
PORT=3000
# Horas que el bot queda en silencio después de un pedido/consulta
HANDOFF_HOURS=12
# Minutos para reiniciar un menú abandonado
SESSION_MINUTES=30
